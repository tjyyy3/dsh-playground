{
  "name": "dsh-playground",
  "version": "0.6.0-beta.2",
  "license": "MIT",
  "type": "module",
  "description": "DSH plugin for Playground challenges: browse challenges, dispatch tasks to Agents, and track submissions and scores.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "playground"
  ],
  "homepage": "https://github.com/tjyyy3/dsh-playground#readme",
  "bugs": {
    "url": "https://github.com/tjyyy3/dsh-playground/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjyyy3/dsh-playground.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "compatibility.json",
    "release-notes/*.md",
    "README.md",
    "README.en.md",
    "guide/*.md",
    "assets/*.png"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.5"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "verify:package": "npm run check:client && node scripts/verify-package.mjs",
    "test": "npm run check:client && npm run build:client && node test/build-client.test.mjs && node test/api.test.mjs && node test/competition-schedules.test.mjs && node test/competitions.test.mjs && node test/challenge-groups.test.mjs && node test/plugin.test.mjs && node test/catalog-tools.test.mjs && node test/controller.test.mjs && node test/codex-chats.test.mjs && node test/workflow.test.mjs && node test/submission.test.mjs && node test/material-access.test.mjs && node test/client.test.mjs && node test/queries.test.mjs && node test/cli.test.mjs && node test/releases.test.mjs && node test/validate-release.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "demo:local": "node scripts/demo-local.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dependencies": {
    "acorn": "8.19.0",
    "ws": "8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
